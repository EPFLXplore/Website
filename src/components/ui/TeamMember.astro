---
import { Linkedin, Github, Twitter, Mail, Globe } from "lucide-react";

export interface Props {
  member: {
    name: string;
    role: string;
    photo?: string | null;
    socials?: Record<string, string | undefined> | null;
    studies?: string | null;
  };
  defaultPhoto: string;
}

const { member, defaultPhoto } = Astro.props;
---

<div class="w-64 rounded-2xl overflow-hidden shadow-lg bg-white/5 border border-gray-700 backdrop-blur-sm hover:shadow-xl transition mx-auto">
  <!-- Background banner -->
  <div
    class="relative h-28 bg-gray-800"
    style={`background-image: url('${member.photo || defaultPhoto}'); background-size: cover; background-position: center;`}
  >
    <div class="absolute inset-0 bg-black/40"></div>
  </div>

  <!-- Profile image -->
  <div class="relative flex justify-center -mt-12">
    <img
      src={member.photo || defaultPhoto}
      alt={member.name}
      class="w-24 h-24 rounded-full border-4 border-white object-cover shadow-md"
    />
  </div>

  <!-- Info -->
  <div class="px-3 pb-6 text-center">
    <h3 class="text-lg font-bold mt-2">{member.name}</h3>
    <p class="text-sm text-gray-400">{member.role}</p>
    <p class="text-sm text-gray-400">{member.studies}</p>

    <!-- Socials -->
    <div class="flex justify-center gap-4 mt-3">
      {member.socials?.linkedin && (
        <a href={member.socials.linkedin} target="_blank" aria-label="LinkedIn" class="hover:text-[#0077b5] transition">
          <Linkedin size={22} />
        </a>
      )}
      {member.socials?.github && (
        <a href={member.socials.github} target="_blank" aria-label="GitHub" class="hover:text-gray-200 transition">
          <Github size={22} />
        </a>
      )}
      {member.socials?.personal && (
        <a href={member.socials.personal} target="_blank" aria-label="Globe" class="hover:text-[#1da1f2] transition">
          <Globe size={22} />
        </a>
      )}
      {member.socials?.email && (
        <a href={`mailto:${member.socials.email}`} aria-label="Email" class="hover:text-red-400 transition">
          <Mail size={22} />
        </a>
      )}
    </div>
  </div>
</div>
