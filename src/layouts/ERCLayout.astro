---
import Menu from "@/components/Menu";
import MainLayout from "./MainLayout.astro";
import RoverModel from "@/components/Rover.tsx";
import GalleryImage from "@/components/GalleryImage.tsx";

const {
  rover,
  drone,
  year,
  heroImage,
  roverImage,
  droneImage,
  results,
  videoId,
  teamImage,
  images,
  technical,
  show_drone,
  show_rover_model,
  show_techincal_section,
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<MainLayout title={`ERC ${year} | EPFL Xplore`}>

  <!-- Header -->
  <div class="absolute top-0 left-0 w-full">
    <Menu client:load />
  </div>

  <!-- Hero -->
  <section class="max-w-6xl mx-auto py-16 sm:py-20 md:py-26 text-center px-4">
    <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold mb-6 sm:mb-10 text-primary">
      European Rover Challenge {year}
    </h1>
    <div class="overflow-hidden rounded-xl shadow-lg">
      <img
        src={`${heroImage}`}
        alt={`ERC ${year} Team`}
        class="w-full h-auto object-cover aspect-[16/9]"
      />
    </div>
  </section>

  <!-- Rover Section -->
  <section class="max-w-6xl mx-auto py-12 sm:py-20 space-y-6 sm:space-y-8 px-4">
    <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-center">
      Rover {show_drone ? "and Drone" : ""} Development
    </h2>
    {show_rover_model ? <RoverModel name={rover.toLowerCase()} baseUrl={baseUrl} client:load /> : null}

    {show_drone ? (
    <!-- TWO-COLUMN MODE -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">

      <div class="overflow-hidden rounded-lg shadow bg-white aspect-[4/3]">
        <img
          src={roverImage}
          alt={rover}
          class="w-full h-full object-cover"
        />
      </div>

      <div class="overflow-hidden rounded-lg shadow bg-white aspect-[4/3]">
        <img
          src={droneImage}
          alt={drone}
          class="w-full h-full object-cover"
        />
      </div>

    </div>
  ) : (
    <!-- SINGLE ROVER MODE -->
    <div class="mt-6 flex justify-center">
      <div class="overflow-hidden rounded-xl shadow bg-white max-w-3xl w-full aspect-[16/9]">
        <img
          src={roverImage}
          alt={rover}
          class="w-full h-full object-cover"
        />
      </div>
    </div>
  )}

  </div>

  <!-- Technical Section -->
  {show_techincal_section && technical && technical.length > 0 && (
    <section class="w-full py-16 sm:py-28 px-4">
      <h2 class="text-2xl sm:text-3xl md:text-5xl font-extrabold text-center mb-12 sm:mb-24 text-primary">
        Rover Technical Overview
      </h2>

      <div class="space-y-20 sm:space-y-40">
        {technical.map((item, idx) => (
          <>
            {item.design === "hero" && (
              <div class="max-w-5xl mx-auto text-center space-y-4 sm:space-y-8">
                <h3 class="text-xl sm:text-2xl md:text-4xl font-bold">{item.title}</h3>
                <p class="text-sm sm:text-base md:text-lg leading-relaxed text-muted-foreground">{item.text}</p>
                {item.image && (
                  <div class="overflow-hidden rounded-2xl bg-white flex justify-center">
                    <img
                      src={`${item.image}`}
                      alt={item.title}
                      class="w-full h-auto object-contain max-w-full mx-auto"
                    />
                  </div>
                )}
              </div>
            )}

            {item.design === "split" && (
              <div
                class={`flex flex-col ${
                  idx % 2 === 0 ? "md:flex-row" : "md:flex-row-reverse"
                } items-center gap-6 sm:gap-12 max-w-7xl mx-auto`}
              >
                <div class="flex-1 space-y-3 sm:space-y-6">
                  <h3 class="text-xl sm:text-2xl md:text-3xl font-semibold">{item.title}</h3>
                  <p class="text-sm sm:text-base md:text-lg text-justify text-muted-foreground leading-relaxed">{item.text}</p>
                </div>
                {item.image && (
                  <div class="flex-1 flex items-center justify-center bg-white rounded-2xl overflow-hidden p-2">
                    <img
                      src={`${item.image}`}
                      alt={item.title}
                      class="w-full h-auto max-w-[600px] object-contain"
                    />
                  </div>
                )}
              </div>
            )}

            {item.design === "wide" && (
              <div class="max-w-7xl mx-auto space-y-4 sm:space-y-6">
                <h3 class="text-xl sm:text-2xl md:text-3xl font-semibold text-center">{item.title}</h3>
                <p class="text-sm sm:text-base md:text-lg text-muted-foreground text-justify max-w-5xl mx-auto mb-20">
                  {item.text}
                </p>
                {item.image && (
                  <div class="overflow-hidden rounded-xl">
                    <img
                      src={`${item.image}`}
                      alt={item.title}
                      class="w-full h-auto object-contain"
                    />
                  </div>
                )}
              </div>
            )}

            {item.design === "features" && (
              <div class="max-w-6xl mx-auto space-y-8 sm:space-y-16">
                <h3 class="text-2xl sm:text-3xl md:text-4xl font-bold text-center mb-6 sm:mb-12">{item.title}</h3>
                <div class="space-y-6 sm:space-y-10">
                  {item.cards &&
                    item.cards.map((c, idx) => (
                      <div
                        class={`flex flex-col md:flex-row ${
                          idx % 2 === 1 ? "md:flex-row-reverse" : ""
                        } items-center gap-6 sm:gap-8 bg-white rounded-2xl shadow-xl overflow-hidden`}
                      >
                        {c.image && (
                          <div class="w-full md:w-1/2 flex justify-center bg-white">
                            <img
                              src={`${c.image}`}
                              alt={c.title}
                              class="w-full h-auto object-contain max-h-[400px]"
                            />
                          </div>
                        )}
                        <div class="flex-1 p-4 sm:p-8">
                          <h4 class="text-lg sm:text-xl md:text-2xl text-black">{c.title}</h4>
                          <p class="text-sm sm:text-base md:text-lg text-muted-foreground mt-2 sm:mt-3 leading-relaxed">
                            {c.text}
                          </p>
                        </div>
                      </div>
                    ))}
                </div>
              </div>
            )}
          </>
        ))}
      </div>
    </section>
  )}

  <!-- Results -->
  <section class="max-w-6xl mx-auto py-12 sm:py-20 space-y-8 sm:space-y-12 px-4">
    <h2 class="text-2xl sm:text-3xl font-bold text-center">Results</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
      {results && results.map((res) => (
        <div class={`rounded-2xl p-1 shadow-lg bg-gradient-to-r ${res.gradient}`}>
          <div class="rounded-xl bg-white p-4 sm:p-6 text-center">
            <h3 class="text-lg sm:text-xl md:text-2xl font-bold text-gray-900">{res.title}</h3>
            <p class="text-sm sm:text-base text-muted-foreground mt-2">{res.text}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Video -->
  <section class="max-w-6xl mx-auto py-8 sm:py-12 space-y-6 sm:space-y-12 px-4">
    <div class="space-y-4">
      <h2 class="text-lg sm:text-xl md:text-2xl font-semibold">Video for Qualifications</h2>
      <iframe
        class="w-full aspect-video rounded-lg shadow"
        src={`https://www.youtube.com/embed/${videoId}`}
        title={`ERC ${year} Highlights`}
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen></iframe>
    </div>
  </section>

  <!-- Team -->
  <section class="max-w-6xl mx-auto py-12 sm:py-20 space-y-6 sm:space-y-8 px-4">
    <h2 class="text-2xl sm:text-3xl font-bold">The Team</h2>
    <div class="overflow-hidden rounded-lg shadow-lg bg-white">
      <img
        src={`${teamImage}`}
        alt={`Team ${year}`}
        class="w-full h-auto object-cover"
      />
    </div>
  </section>

  <!-- Gallery -->
  <section class="max-w-6xl mx-auto py-12 sm:py-20 space-y-6 sm:space-y-8 px-4">
    <h2 class="text-2xl sm:text-3xl font-bold">Gallery</h2>
    <GalleryImage images={images} year={year} client:load />
  </section>

</MainLayout>
