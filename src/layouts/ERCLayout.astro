---
import Menu from "@/components/Menu";
import MainLayout from "./MainLayout.astro";
import Rover from "@/components/Rover";

/**
 * @property {string} title
 * @property {string} text
 * @property {string} gradient
 */

const {
  rover,
  drone,
  sentence_intro,
  year,
  title,
  heroImage,
  roverImage,
  droneImage,
  /** @type {Result[]} */
  results,
  videoId,
  teamImage,
  /** @type {string[]} */
  images,
  technical
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL;
---

<MainLayout title={`ERC ${year} | EPFL Xplore`}>
  <!-- Header -->
  <div class="absolute top-0 left-0 w-full">
    <Menu client:load />
  </div>

  <!-- Hero Section -->
  <section class="max-w-6xl mx-auto py-26 text-center">
    <h1 class="text-5xl font-extrabold mb-10 text-primary">{title}</h1>
    <img
      src={`${baseUrl}/images/${year}/${heroImage}`}
      alt={`ERC ${year} Team`}
      class="rounded-xl shadow-lg w-full object-cover max-h-[750px] mx-auto"
    />
  </section>

  <!-- Rover Section -->
  <section class="max-w-6xl mx-auto py-20 space-y-8">
    <h2 class="text-4xl font-bold text-center">Rover & Drone Development</h2>
    <Rover client:load />

    <p class="mt-20">
      We present <strong>{rover}</strong> and our aerial drone <strong
        >{drone}</strong
      >.
      {sentence_intro}
    </p>
    <div class="grid md:grid-cols-2 gap-6 mt-6">
      <img
        src={`${baseUrl}/images/${year}/${roverImage}`}
        alt="Rover"
        class="rounded-lg shadow"
      />
      <img
        src={`${baseUrl}/images/${year}/${droneImage}`}
        alt="Drone"
        class="rounded-lg shadow"
      />
    </div>
  </section>

    <!-- Technical Section -->
  {technical && technical.length > 0 && (
    <section class="w-full py-28">
      <h2 class="text-5xl font-extrabold text-center mb-24 text-primary">
        Rover Technical Overview
      </h2>

      <div class="space-y-40">
        {technical.map((item, idx) => (
          <>
            {item.design === "hero" && (
              <div class="max-w-5xl mx-auto text-center space-y-8">
                <h3 class="text-4xl font-bold">{item.title}</h3>
                <p class="text-lg leading-relaxed text-muted-foreground">
                  {item.text}
                </p>
                {item.image && (
                  <img
                    src={`${baseUrl}/images/${year}/${item.image}`}
                    alt={item.title}
                    class="rounded-2xl shadow-xl w-full object-cover max-h-[600px] mx-auto"
                  />
                )}
              </div>
            )}

            {item.design === "split" && (
              <div
                class={`flex flex-col ${
                  idx % 2 === 0 ? "md:flex-row" : "md:flex-row-reverse"
                } items-center gap-12 max-w-7xl mx-auto`}
              >
                <div class="flex-1 space-y-6">
                  <h3 class="text-3xl font-semibold">{item.title}</h3>
                  <p class="text-lg text-muted-foreground leading-relaxed">
                    {item.text}
                  </p>
                </div>
                {item.image && (
                  <div class="flex-1">
                    <img
                      src={`${baseUrl}/images/${year}/${item.image}`}
                      alt={item.title}
                      class="rounded-2xl shadow-lg w-full object-cover max-h-[500px]"
                    />
                  </div>
                )}
              </div>
            )}

            {item.design === "wide" && (
              <div class="max-w-7xl mx-auto space-y-6">
                <h3 class="text-3xl font-semibold text-center">{item.title}</h3>
                <p class="text-lg text-muted-foreground text-center max-w-3xl mx-auto">
                  {item.text}
                </p>
                {item.image && (
                  <img
                    src={`${baseUrl}/images/${year}/${item.image}`}
                    alt={item.title}
                    class="rounded-xl shadow-lg w-full object-cover max-h-[700px]"
                  />
                )}
              </div>
            )}

            {item.design === "features" && (
              <div class="max-w-6xl mx-auto space-y-16">
                <h3 class="text-4xl font-bold text-center mb-12">{item.title}</h3>
                <div class="space-y-10">
                  {item.cards &&
                    item.cards.map((c, idx) => (
                      <div
                        class={`flex flex-col md:flex-row ${
                          idx % 2 === 1 ? "md:flex-row-reverse" : ""
                        } items-center gap-8 bg-white rounded-2xl shadow-xl overflow-hidden`}
                      >
                        <!-- Image -->
                        {c.image && (
                          <img
                            src={`${baseUrl}/images/${year}/${c.image}`}
                            alt={c.title}
                            class="w-full md:w-1/2 h-64 object-cover"
                          />
                        )}

                        <!-- Text -->
                        <div class="flex-1 p-8">
                          <h4 class="text-2xl text-black">{c.title}</h4>
                          <p class="text-lg text-muted-foreground mt-3 leading-relaxed">
                            {c.text}
                          </p>
                        </div>
                      </div>
                    ))}
                </div>
              </div>
            )}

          </>
        ))}
      </div>
    </section>
  )}


  <!-- Results -->
  <section class="max-w-6xl mx-auto py-20 space-y-12">
    <h2 class="text-3xl font-bold text-center">Results</h2>
    <div class="grid md:grid-cols-2 gap-8">
      {
        results &&
          results.map((res) => (
            <div
              class={`rounded-2xl p-1 shadow-lg bg-gradient-to-r ${res.gradient}`}
            >
              <div class="rounded-xl bg-white p-6 text-center">
                <h3 class="text-2xl font-bold text-gray-900">{res.title}</h3>
                <p class="text-muted-foreground mt-2">{res.text}</p>
              </div>
            </div>
          ))
      }
    </div>
  </section>

  <!-- Video -->
  <section class="max-w-6xl mx-auto py-5 space-y-12">
    <div class="space-y-4">
      <h2 class="text-2xl font-semibold">Video for Qualifications</h2>
      <iframe
        class="w-full aspect-video rounded-lg shadow"
        src={`https://www.youtube.com/embed/${videoId}`}
        title={`ERC ${year} Highlights`}
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen></iframe>
    </div>
  </section>

  <!-- Team -->
  <section class="max-w-6xl mx-auto py-20 space-y-8">
    <h2 class="text-3xl font-bold">The Team</h2>
    <img
      src={`${baseUrl}/images/${year}/${teamImage}`}
      alt={`Team ${year}`}
      class="rounded-lg shadow-lg w-full"
    />
  </section>

  <!-- Gallery -->
  <section class="max-w-6xl mx-auto py-20 space-y-8">
    <h2 class="text-3xl font-bold">Gallery</h2>
    <div class="grid md:grid-cols-3 gap-4">
      {
        images &&
          images.map((src, idx) => (
            <img
              src={src}
              alt={`ERC ${year} Gallery ${idx + 1}`}
              class="rounded-lg shadow hover:scale-105 transition-transform"
              loading="lazy"
            />
          ))
      }
    </div>
  </section>
</MainLayout>
