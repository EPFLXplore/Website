---
import Menu from "@/components/Menu";
import MainLayout from "./MainLayout.astro";
import { Card } from "@/components/ui/card";
import { Button } from "@/components/ui/button";

const {
    title,
    status,
    year,
    tagline,
    team,
    links,
    heroImage,
    sections
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<MainLayout title={`${title} | Xplore Research | EPFL Xplore`}>
  <!-- Header -->
  <div class="absolute top-0 left-0 w-full z-50">
    <Menu client:load />
  </div>

  <!-- Hero -->
  <section class="pt-28 sm:pt-32 pb-10 px-4">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
      <div>
        <div class="flex flex-wrap items-center gap-2 mb-4">
          <span class="text-xs font-semibold px-2 py-1 rounded-full bg-purple-600 text-foreground">
            {status}
          </span>
          <span class="text-xs font-semibold px-2 py-1 rounded-full bg-purple-600 text-foreground">
            {year}
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold leading-tight">
          {title}
        </h1>

        <p class="text-sm sm:text-base md:text-lg text-muted-foreground mt-4 max-w-xl">
          {tagline}
        </p>

        <div class="mt-6 flex flex-col sm:flex-row gap-3">
          {links.map((l) => (
            <a download href={l.href} target={l.href.startsWith("http") ? "_blank" : undefined}>
              <Button className="w-full sm:w-auto">{l.label}</Button>
            </a>
          ))}
        </div>

        <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
          <div class="bg-gray-800/70 border border-gray-700 rounded-xl p-4 w-fit max-w-full">
            <p class="text-gray-300 font-semibold mb-2">Team</p>
            <div class="flex flex-wrap gap-2">
              {team.map((m) => (
                <div class="flex items-center gap-2 rounded-full border border-gray-700 bg-gray-900 px-3 py-1">
                  <span class="text-sm text-gray-100 font-medium">{m.name}</span>
                  {m.role && (
                    <span class="text-xs text-gray-300 bg-gray-800 px-2 py-0.5 rounded-full">
                      {m.role}
                    </span>
                  )}
                </div>
              ))}
            </div>
          </div>
        </div>

      </div>

      <div class="relative rounded-2xl overflow-hidden shadow-[0_40px_100px_-30px_rgba(0,0,0,0.9)]">
        <img
            src={heroImage}
            alt={title}
            class="w-full h-[260px] sm:h-[360px] lg:h-[420px] object-cover"
        />
        <div class="absolute inset-0 pointer-events-none bg-gradient-to-t from-black/20 via-transparent to-transparent"></div>
        </div>
    </div>
  </section>

  <!-- Sections (text + carousel with arrows) -->
  <section class="px-4 pb-16">
    <div class="max-w-6xl mx-auto space-y-8">
      {sections.map((s, idx) => (
        <Card>
          <div class="p-6 grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
            <!-- Text -->
            <div>
              <h2 class="text-xl sm:text-2xl font-bold">{s.title}</h2>
              <p class="text-sm sm:text-base text-muted-foreground mt-1">
                {s.subtitle}
              </p>

              {s.body && (
                <div class="mt-4 space-y-3 text-sm sm:text-base text-muted-foreground">
                  {s.body.map((p) => <p>{p}</p>)}
                </div>
              )}

              {s.bullets && (
                <ul class="mt-4 list-disc pl-5 space-y-2 text-sm sm:text-base text-muted-foreground">
                  {s.bullets.map((b) => <li>{b}</li>)}
                </ul>
              )}
            </div>

            <!-- Carousel -->
            <div class="relative rounded-2xl border border-gray-700 bg-gray-900 overflow-hidden">
              
              <!-- Track -->
              <div
                id={`carousel-${idx}`}
                class="p-3 flex gap-3 overflow-x-auto snap-x snap-mandatory scroll-smooth no-scrollbar"
              >
                {s.media.map((m) => (
                  <div class="min-w-[90%] sm:min-w-[80%] snap-start">
                    <div class="rounded-xl overflow-hidden border border-gray-700 bg-gray-950">
                      {m.type === "image" ? (
                        <img src={m.src} alt={m.alt} class="w-full h-56 sm:h-64 object-cover" />
                      ) : (
                        <div class="aspect-video w-full">
                          <iframe
                            class="w-full h-full"
                            src={m.src}
                            title={m.alt}
                            frameborder="0"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                            allowfullscreen
                          />
                        </div>
                      )}
                      <div class="px-3 py-2 text-xs text-gray-300">{m.alt}</div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </Card>
      ))}
    </div>
  </section>

  <!-- Define global scroll function -->
  <script is:inline>
    window.__scrollCarousel = (id, dir) => {
      const el = document.getElementById(id);
      if (!el) return;

      // Move exactly one "slide" (card) if possible
      const first = el.querySelector(".snap-start");
      if (!first) return;

      const gapPx = 12; // gap-3 ≈ 12px
      const step = first.getBoundingClientRect().width + gapPx;

      el.scrollBy({ left: dir * step, behavior: "smooth" });
    };
  </script>
</MainLayout>