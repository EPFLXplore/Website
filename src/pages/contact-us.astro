---
import MainLayout from "../layouts/MainLayout.astro";
import {
  Card,
  CardHeader,
  CardTitle,
  CardDescription,
} from "../components/ui/card";
import Menu from "@/components/Menu";

const baseUrl = import.meta.env.BASE_URL;
---

<MainLayout title="Contact Us | EPFL Xplore">

  <!-- Header -->
  <div class="absolute top-0 left-0 w-full z-50">
    <Menu client:load />
  </div>

  <div class="px-6 md:px-12 lg:px-16 py-24 max-w-7xl mx-auto">
    <h1 class="text-5xl font-bold mb-6 text-center">Contact Us</h1>
  </div>

  <div class="flex flex-row gap-8 w-full justify-center mt-5 h-[500px] group">
  <!-- Sponsor Card -->
  <a href={`${baseUrl}/partnerships`} class="no-underline">
    <Card
      className="relative h-full w-[450px] cursor-pointer group/card overflow-hidden transition-all duration-500 ease-in-out group-hover:w-[400px] hover:!w-[600px] hover:z-20"
    >
      <img
        src=`${baseUrl}/images/main/become_sponsor.png`
        alt="Become a Sponsor"
        class="absolute inset-0 w-full h-full object-cover group-hover/card:scale-105 transition-transform duration-300"
      />
      <div
        class="absolute inset-0 bg-black/50 group-hover/card:bg-black/60 transition-colors duration-300"
      ></div>
      <div class="relative z-10 flex flex-col h-full justify-end p-6">
        <CardHeader className="p-0">
          <CardTitle
            className="text-white text-5xl group-hover/card:text-6xl transition-all duration-300"
          >
            Become a Sponsor
          </CardTitle>
          <CardDescription
            className="text-white/80 group-hover/card:text-white/90 transition-all duration-300"
          >
            Partner with us to support the next generation of ambitious engineers
          </CardDescription>
        </CardHeader>
      </div>
    </Card>
  </a>

  <!-- Join the Team Card -->
  <a href={`${baseUrl}/join-us`} class="no-underline">
    <Card
      className="relative h-full w-[450px] cursor-pointer group/card overflow-hidden transition-all duration-500 ease-in-out group-hover:w-[400px] hover:!w-[600px] hover:z-20"
    >
      <img
        src={`${baseUrl}/images/main/join_the_team.jpg`}
        alt="Join the Team"
        class="absolute inset-0 w-full h-full object-cover group-hover/card:scale-105 transition-transform duration-300"
      />
      <div
        class="absolute inset-0 bg-black/50 group-hover/card:bg-black/60 transition-colors duration-300"
      ></div>
      <div class="relative z-10 flex flex-col h-full justify-end p-6">
        <CardHeader className="p-0">
          <CardTitle
            className="text-white text-5xl group-hover/card:text-6xl transition-all duration-300"
          >
            Join the Team
          </CardTitle>
          <CardDescription
            className="text-white/80 group-hover/card:text-white/90 transition-all duration-300"
          >
            Join a dynamic community of ambitious students eager to conquer challenges together
          </CardDescription>
        </CardHeader>
      </div>
    </Card>
  </a>
</div>

</MainLayout>
