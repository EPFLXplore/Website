---
import MainLayout from "../layouts/MainLayout.astro";
import {
  Card,
  CardHeader,
  CardTitle,
  CardDescription,
} from "../components/ui/card";
import Menu from "@/components/Menu";

const baseUrl = import.meta.env.BASE_URL;
---

<MainLayout title="Contact Us | EPFL Xplore">

  <!-- Header -->
  <div class="absolute top-0 left-0 w-full z-50">
    <Menu client:load />
  </div>

  <!-- Page Title -->
  <div class="px-4 sm:px-6 md:px-12 lg:px-16 py-16 sm:py-24 max-w-7xl mx-auto">
    <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-6 text-center">
      Contact Us
    </h1>
  </div>

  <!-- Cards -->
  <div class="flex flex-col sm:flex-row gap-6 sm:gap-8 w-full justify-center px-4 sm:px-6 md:px-0">
    <!-- Sponsor Card -->
    <a href={`${baseUrl}/partnerships`} class="no-underline w-full sm:w-[450px]">
      <Card
        className="relative h-72 sm:h-[500px] cursor-pointer group/card overflow-hidden transition-all duration-500 ease-in-out"
      >
        <img
          src={`${baseUrl}/images/main/become_sponsor.png`}
          alt="Become a Sponsor"
          class="absolute inset-0 w-full h-full object-cover group-hover/card:scale-105 transition-transform duration-300"
        />
        <div class="absolute inset-0 bg-black/50 group-hover/card:bg-black/60 transition-colors duration-300"></div>
        <div class="relative z-10 flex flex-col h-full justify-end p-4 sm:p-6">
          <CardHeader className="p-0">
            <CardTitle className="text-white text-2xl sm:text-4xl md:text-5xl transition-all duration-300">
              Become a Sponsor
            </CardTitle>
            <CardDescription className="text-white/80 text-sm sm:text-base md:text-lg transition-all duration-300">
              Partner with us to support the next generation of ambitious engineers
            </CardDescription>
          </CardHeader>
        </div>
      </Card>
    </a>

    <!-- Join the Team Card -->
    <a href={`${baseUrl}/join-us`} class="no-underline w-full sm:w-[450px]">
      <Card
        className="relative h-72 sm:h-[500px] cursor-pointer group/card overflow-hidden transition-all duration-500 ease-in-out"
      >
        <img
          src={`${baseUrl}/images/main/join_the_team.jpg`}
          alt="Join the Team"
          class="absolute inset-0 w-full h-full object-cover group-hover/card:scale-105 transition-transform duration-300"
        />
        <div class="absolute inset-0 bg-black/50 group-hover/card:bg-black/60 transition-colors duration-300"></div>
        <div class="relative z-10 flex flex-col h-full justify-end p-4 sm:p-6">
          <CardHeader className="p-0">
            <CardTitle className="text-white text-2xl sm:text-4xl md:text-5xl transition-all duration-300">
              Join the Team
            </CardTitle>
            <CardDescription className="text-white/80 text-sm sm:text-base md:text-lg transition-all duration-300">
              Join a dynamic community of ambitious students eager to conquer challenges together
            </CardDescription>
          </CardHeader>
        </div>
      </Card>
    </a>
  </div>

</MainLayout>
