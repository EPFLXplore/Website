---
import { Alert, AlertDescription, AlertTitle } from "@/components/ui/alert";
import MainLayout from "../layouts/MainLayout.astro";
import { ArrowRight, MessageSquareWarning } from "lucide-react";
import { Button } from "@/components/ui/button";
import Menu from "@/components/Menu";

const baseUrl = import.meta.env.BASE_URL;
---

<MainLayout title="Join Us | EPFL Xplore">

  <!-- Header -->
  <div class="absolute top-0 left-0 w-full z-50">
    <Menu client:load />
  </div>

  <!-- Hero -->
  <div class="px-4 sm:px-6 md:px-12 lg:px-16 py-16 sm:py-24 max-w-7xl mx-auto">
    <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-6 text-center">
      Join Us
    </h1>
    <p class="font-light text-sm sm:text-base md:text-lg text-center max-w-3xl mx-auto mb-10 sm:mb-16">
      EPFL Xplore is always looking for motivated students to join our team.
      Whether you're interested in robotics, software development, marketing, or
      event organization, there's a place for you here. Join us to work on
      exciting projects, gain hands-on experience, and be part of a dynamic team
      that is passionate about technology and innovation.
    </p>
  </div>

  <div class="w-full px-2 sm:px-4 md:px-8">
    <iframe
      src="https://docs.google.com/forms/d/e/1FAIpQLSduGomCrdNnph9Vg9TtsgqYaqnlcRC7UFVvyXa7YGVLjwncvw/viewform?embedded=true"
      class="w-full max-w-[1200px] mx-auto h-[80vh] min-h-[1100px] border-0 rounded-lg shadow-xl"
      loading="lazy"
    >
      Loading…
    </iframe>
  </div>
</MainLayout>
