---
import { Alert, AlertDescription, AlertTitle } from "@/components/ui/alert";
import MainLayout from "../layouts/MainLayout.astro";
import { ArrowRight, MessageSquareWarning } from "lucide-react";
import { Button } from "@/components/ui/button";
import Menu from "@/components/Menu";

const baseUrl = import.meta.env.BASE_URL;
---

<MainLayout title="Join Us | EPFL Xplore">

  <!-- Header -->
  <div class="absolute top-0 left-0 w-full z-50">
    <Menu client:load />
  </div>

  <div class="px-6 md:px-12 lg:px-16 py-24 max-w-7xl mx-auto">
    <h1 class="text-5xl font-bold mb-6 text-center">Join Us</h1>
    <p class="font-light text-lg text-center max-w-3xl mx-auto mb-16">
      EPFL Xplore is always looking for motivated students to join our team.
      Whether you're interested in robotics, software development, marketing, or
      event organization, there's a place for you here. Join us to work on
      exciting projects, gain hands-on experience, and be part of a dynamic team
      that is passionate about technology and innovation.
    </p>
  </div>

  <div class="w-full flex justify-center">
    <iframe
      src="https://docs.google.com/forms/d/e/1FAIpQLSed4U8FYSrjUYA6L38pA3EAhHXEUW-YM9NOSwpodN6W3x8tVQ/viewform?embedded=true"
      width="1000"
      height="1900"
      frameborder="0"
      marginheight="0"
      marginwidth="0">Loading…</iframe
    >
  </div>
</MainLayout>
