---
import Menu from "@/components/Menu";
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Become a Sponsor | EPFL Xplore">

  <!-- Header -->
  <div class="absolute top-0 left-0 w-full z-50">
    <Menu client:load />
  </div>

  <!-- Hero -->
  <section class="relative bg-gradient-to-b from-blue-900 via-purple-900 to-black py-28 text-center text-white">
    <h1 class="text-6xl font-extrabold mb-6">Become a Sponsor</h1>
    <p class="text-xl max-w-3xl mx-auto opacity-90 leading-relaxed">
      Partner with us to support the next generation of ambitious engineers. By sponsoring EPFL Xplore, you contribute to the development of cutting-edge projects and help students gain invaluable hands-on experience.
    </p>
  </section>

  <!-- Sponsoring Dossier -->
  <section class="max-w-6xl mx-auto px-6 py-16">
    <h2 class="text-3xl font-bold mb-6 text-center text-primary">Our Sponsorship Dossier</h2>
    <p class="text-center text-muted-foreground mb-8">
      Discover our sponsorship tiers, benefits, and how you can help shape the future of student-led space robotics.
    </p>
    <iframe
      src="https://docs.google.com/presentation/d/e/2PACX-1vRFC0MiqG19mlOrQCTQu5b516XWM6-7Dw_K2bphy6YwcLF8Igv4f1V11tJTEXJK_H38We78BYnTacy0/pubembed?start=false&loop=false"
      frameborder="0"
      allowfullscreen="true"
      class="mx-auto w-full h-[600px] md:h-[800px] rounded-xl shadow-lg"
    ></iframe>
  </section>

  <!-- Legal Guidelines -->
  <section class="bg-gray-100 py-16">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="text-3xl font-bold mb-6 text-center text-black">Important Legal Framework</h2>
      <p class="text-center text-gray-700 mb-10">
        Sponsorship at EPFL must comply with MAKE guidelines. Below is the official document required for any partnership agreement:
      </p>

      <!-- Centered Card -->
      <div class="flex justify-center">
        <a
          href="https://make.epfl.ch/wiki/public/admin/important_legal_guidelines_for_make_interdisciplinary_projects#useful_documents_to_download"
          target="_blank"
          class="p-6 bg-white rounded-xl shadow hover:shadow-md transition w-full max-w-md text-center"
        >
          <h3 class="font-semibold text-lg text-black mb-2">📑 Three-Parties Contract (EN)</h3>
          <p class="text-gray-600">
            Official template for EPFL sponsoring agreements.
          </p>
        </a>
      </div>
    </div>
  </section>


</MainLayout>
