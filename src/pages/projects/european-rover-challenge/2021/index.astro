---
import ERCPage from "../../../../layouts/ERCLayout.astro"

const results = [
  {
    title: "🥉 3rd Place Overall",
    text: "EPFL Xplore achieves podium with it's first participation!",
    gradient: "from-yellow-400 via-orange-400 to-red-400",
  },
  {
    title: "⭐ Probing & Science Excellencies",
    text: "Special awards for 2 Tasks in first edition",
    gradient: "from-blue-500 via-indigo-500 to-purple-600",
  },
];

// Glob import here, pass images as prop
const baseUrl = import.meta.env.BASE_URL;
const imagesGlob = import.meta.glob("/public/images/2021/*.jpg", { eager: true });
const images = Object.keys(imagesGlob).map((path) => `${baseUrl}/images/2021/${path.split("/").pop()}`);

const technical = [
  {
    title: "Subsystems Control",
    text: "",
    image: "15.jpg",
    design: "split",
  },
  {
    title: "Robustness of Robotic Arm",
    text: "",
    image: "14.jpg",
    design: "hero",
  },
  {
    title: "Autonomy in Software Architecture",
    text: "",
    image: "13.jpg",
    design: "wide",
  },
  {
    title: "Drill System",
    design: "features",
    cards: [
      { title: "", text: "", image: "16.jpg" },
      { title: "", text: "", image: "17.jpg" },
    ],
  },
];

---

<ERCPage
  rover="Argos"
  drone=""
  sentence_intro=""
  year="2021"
  title="European Rover Challenge 2021"
  heroImage="team.jpg"
  roverImage="argos.jpg"
  droneImage="7.jpg"
  results={results}
  videoId="zbsS0uqnrJQ"
  teamImage="team_2.jpg"
  galleryCount={22}
  images={images}
