---
import ERCPage from "../../../../layouts/ERCLayout.astro"

const results = [
  {
    title: "🥈 2nd Place Overall",
    text: "Astra and it's team achieved an incredible performance even in the night!",
    gradient: "from-yellow-400 via-orange-400 to-red-400",
  },
  {
    title: "⭐ Navigation Excellency",
    text: "Special award Navigation Task",
    gradient: "from-blue-500 via-indigo-500 to-purple-600",
  },
];


// Glob import here, pass images as prop
const baseUrl = import.meta.env.BASE_URL;
const imagesGlob = import.meta.glob("/public/images/2022/*.jpg", { eager: true });
const images = Object.keys(imagesGlob).map((path) => `${baseUrl}/images/2022/${path.split("/").pop()}`);

const technical = [
  {
    title: "Subsystems Control",
    text: "",
    image: "15.jpg",
    design: "split",
  },
  {
    title: "Robustness of Robotic Arm",
    text: "",
    image: "14.jpg",
    design: "hero",
  },
  {
    title: "Autonomy in Software Architecture",
    text: "",
    image: "13.jpg",
    design: "wide",
  },
  {
    title: "Drill System",
    design: "features",
    cards: [
      { title: "", text: "", image: "16.jpg" },
      { title: "", text: "", image: "17.jpg" },
    ],
  },
];

---

<ERCPage
  rover="Astra"
  drone=""
  sentence_intro=""
  year="2022"
  title="European Rover Challenge 2022"
  heroImage="team.jpg"
  roverImage="astra.jpg"
  droneImage="7.jpg"
  results={results}
  videoId="UUAIprJ8epM"
  teamImage="team_2.jpg"
  galleryCount={22}
  images={images}
  technical={technical}
  show_rover_model={false}
  show_techincal_section={false}
/>