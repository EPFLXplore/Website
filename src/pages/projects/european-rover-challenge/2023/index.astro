---
import ERCPage from "../../../../layouts/ERCLayout.astro"

const results = [
  {
    title: "🥉 3rd Place Overall",
    text: "EPFL Xplore 2023 ends its journey with a podium for the third time.",
    gradient: "from-yellow-400 via-orange-400 to-red-400",
  },
  {
    title: "⭐ Maintenance Excellency",
    text: "Special award Maintenance Task, achieved with its new Robotic Arm.",
    gradient: "from-blue-500 via-indigo-500 to-purple-600",
  },
];

// Glob import here, pass images as prop
const baseUrl = import.meta.env.BASE_URL;
const imagesGlob = import.meta.glob("/public/images/2023/*.jpg", { eager: true });
const images = Object.keys(imagesGlob).map((path) => `${baseUrl}/images/2023/${path.split("/").pop()}`);

const technical = [
  {
    title: "Subsystems Control",
    text: "",
    image: "15.jpg",
    design: "split",
  },
  {
    title: "Robustness of Robotic Arm",
    text: "",
    image: "14.jpg",
    design: "hero",
  },
  {
    title: "Autonomy in Software Architecture",
    text: "",
    image: "13.jpg",
    design: "wide",
  },
  {
    title: "Drill System",
    design: "features",
    cards: [
      { title: "", text: "", image: "16.jpg" },
      { title: "", text: "", image: "17.jpg" },
    ],
  },
];

---

<ERCPage
  rover="Kerby"
  drone="Brokkoly"
  sentence_intro=""
  year="2023"
  title="European Rover Challenge 2023"
  heroImage="team.jpg"
  roverImage="kerby.jpg"
