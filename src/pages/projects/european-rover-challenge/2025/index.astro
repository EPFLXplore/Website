---
import ERCPage from "../../../../layouts/ERCLayout.astro"

const results = [
  {
    title: "🥇 1st Place Overall",
    text: "EPFL Xplore won the ERC 2025 for the first time in history!",
    gradient: "from-yellow-400 via-orange-400 to-red-400",
  },
  {
    title: "⭐ Navigation Droning Excellency",
    text: "Special award for outstanding drone-assisted navigation.",
    gradient: "from-blue-500 via-indigo-500 to-purple-600",
  },
];

// Glob import here, pass images as prop
const baseUrl = import.meta.env.BASE_URL;
const imagesGlob = import.meta.glob("/public/images/2025/*.jpg", { eager: true });
const images = Object.keys(imagesGlob).map((path) => `${baseUrl}/images/2025/${path.split("/").pop()}`);
---

<ERCPage
  rover="Phoenyx"
  drone="Bumblebee"
  sentence_intro="A strong focus has been made on maintenability and robustness, giving us time to simulate tasks of the competition and improve our autonomy."
  year="2025"
  title="European Rover Challenge 2025"
  heroImage="11.jpg"
  roverImage="phoenyx.jpg"
  droneImage="7.jpg"
  results={results}
  videoId="OPM6HM0tbqo"
  teamImage="Team_Photo.jpg"
  images={images}
/>