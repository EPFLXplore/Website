---
import NewsLink from "@/components/NewsLink";
import { base } from "astro:config/server";
import MainLayout from "../../../layouts/MainLayout.astro";
import {
  Card,
  CardHeader,
  CardTitle,
  CardDescription,
} from "../../../components/ui/card";
import { Button } from "@/components/ui/button";
import Menu from "@/components/Menu";

const baseUrl = import.meta.env.BASE_URL;
---

<MainLayout title="Xplore Research | EPFL Xplore">

  <!-- Header -->
  <div class="absolute top-0 left-0 w-full">
    <Menu client:load />
  </div>

  <!-- Hero -->
  <section class="max-w-6xl mx-auto py-16 sm:py-26 text-center px-4">
    <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold mb-4 text-primary">
      Xplore Research
    </h1>
    <p class="text-sm sm:text-base md:text-lg text-muted-foreground max-w-3xl mx-auto">
      The third pole of EPFL Xplore, dedicated to shaping the future of space robotics through innovation,
      experimentation, and student-led engineering.
    </p>

    <img 
      src={`${baseUrl}/images/xre/xre.jpg`} 
      alt="Xplore Research" 
      class="rounded-xl mt-8 sm:mt-10 shadow-lg w-full object-cover max-h-[250px] sm:max-h-[400px] md:max-h-[500px] mx-auto"
    />
  </section>

  <!-- THEN & NOW -->
  <section class="max-w-6xl mx-auto py-16 sm:py-20 grid grid-cols-1 md:grid-cols-2 gap-8 sm:gap-12 items-start px-4">
    <!-- THEN -->
    <div>
      <h2 class="text-2xl sm:text-3xl font-bold mb-4 text-primary">Then: Defined Projects</h2>
      <p class="text-sm sm:text-base text-muted-foreground mb-6">
        Between <strong>2023 and 2025</strong>, Xplore Research launched pioneering projects such as:
      </p>
      <div class="space-y-4">
        <Card className="overflow-hidden">
          <img src={`${baseUrl}/images/xre/legged.jpg`} alt="Chienpanzé" class="w-full h-32 sm:h-40 object-cover" />
          <CardHeader>
            <CardTitle>Chienpanzé</CardTitle>
            <CardDescription>Prototype of a legged robot</CardDescription>
          </CardHeader>
        </Card>
        <Card className="overflow-hidden">
          <img src={`${baseUrl}/images/xre/walle.jpg`} alt="WALL-E" class="w-full h-32 sm:h-40 object-cover" />
          <CardHeader>
            <CardTitle>WALL-E</CardTitle>
            <CardDescription>Recycling plastic into filament</CardDescription>
          </CardHeader>
        </Card>
        <Card className="overflow-hidden">
          <img src={`${baseUrl}/images/xre/ai.jpg`} alt="AI Division" class="w-full h-32 sm:h-40 object-cover" />
          <CardHeader>
            <CardTitle>AI Division</CardTitle>
            <CardDescription>Exploring AI for the European Rover Challenge and beyond</CardDescription>
          </CardHeader>
        </Card>
      </div>
    </div>

    <!-- NOW + Objectives -->
    <div class="flex flex-col gap-8">
      <div class="bg-gray-800/80 rounded-2xl p-6 sm:p-8 border border-gray-700 shadow-xl">
        <h2 class="text-2xl sm:text-3xl font-bold mb-4 text-white">Now: Call for Proposals</h2>
        <p class="text-sm sm:text-base text-gray-300 mb-6">
          Starting <strong>September 2025</strong>, Xplore Research is opening its doors to <strong>student-led projects</strong>.  
          Any EPFL Bachelor’s or Master’s student can submit their idea, form a team, and compete for
          access to labs, resources, and funding.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href={`${baseUrl}/docx/Xplore_Research_Proposal_Document.docx`} download>
            <Button className="w-full sm:w-auto">📄 Download Template</Button>
          </a>
          <a href="https://forms.gle/MGoKjXAtmY9Cp8pF9" target="_blank">
            <Button variant="secondary" className="w-full sm:w-auto">Submit Proposal</Button>
          </a>
        </div>
      </div>

      <div class="bg-gray-800/80 rounded-2xl p-6 sm:p-8 border border-gray-700 shadow-xl">
        <h2 class="text-2xl sm:text-3xl font-bold mb-4 text-white">Strategic Objectives</h2>
        <p class="text-sm sm:text-base text-gray-300 mb-6">
          Discover the long-term vision and roadmap of Xplore Research.  
          This document outlines our key objectives for the coming years.
        </p>
        <div class="flex justify-center">
          <a href={`${baseUrl}/pdfs/plan_strategique_XRE.pdf`} download>
            <Button className="w-full sm:w-auto">📑 Download Strategic Objectives</Button>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Why this change -->
  <section class="max-w-5xl mx-auto py-12 sm:py-16 space-y-6 text-center px-4">
    <h2 class="text-2xl sm:text-3xl font-bold">Why this Evolution?</h2>
    <p class="text-sm sm:text-base md:text-lg text-muted-foreground max-w-3xl mx-auto">
      Xplore Research started as a hub for predefined projects, but now it evolves into a platform for <strong>your ideas</strong>.
      By empowering students to propose, design, and lead projects, XRE becomes a space of independent thinking,
      interdisciplinarity, and innovation in space robotics.
    </p>
    <blockquote class="italic text-gray-200 text-sm sm:text-base">
      “Xplore Research is not about what we decide, it’s about what you create.”
    </blockquote>
  </section>

  <!-- Proposal Journey -->
  <section class="max-w-6xl mx-auto py-16 sm:py-20 px-4">
    <h2 class="text-2xl sm:text-3xl font-bold text-center mb-8 sm:mb-12">The Proposal Journey</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6 text-center">
      <div class="p-6 rounded-lg bg-muted shadow">
        <h3 class="text-lg sm:text-xl font-semibold mb-2">1. Proposal</h3>
        <p class="text-sm sm:text-base text-muted-foreground">Form a team & submit your idea</p>
      </div>
      <div class="p-6 rounded-lg bg-muted shadow">
        <h3 class="text-lg sm:text-xl font-semibold mb-2">2. Review</h3>
        <p class="text-sm sm:text-base text-muted-foreground">Xplore evaluates feasibility</p>
      </div>
      <div class="p-6 rounded-lg bg-muted shadow">
        <h3 class="text-lg sm:text-xl font-semibold mb-2">3. Prototype</h3>
        <p class="text-sm sm:text-base text-muted-foreground">Design & build your project</p>
      </div>
      <div class="p-6 rounded-lg bg-muted shadow">
        <h3 class="text-lg sm:text-xl font-semibold mb-2">4. Demonstration</h3>
        <p class="text-sm sm:text-base text-muted-foreground">Present final results</p>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="relative bg-gradient-to-r from-purple-700 to-blue-700 py-16 sm:py-20 text-center rounded-xl max-w-6xl mx-auto shadow-lg px-4">
    <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-white mb-4 sm:mb-6">
      Your idea could be the next leap in space robotics
    </h2>
    <p class="text-sm sm:text-base md:text-lg text-gray-200 mb-6 sm:mb-8">
      Join Xplore Research and make it happen
    </p>
    <div class="flex flex-col sm:flex-row justify-center gap-4">
      <a href={`${baseUrl}/docx/Xplore_Research_Proposal_Document.docx`} download>
        <Button className="w-full sm:w-auto bg-white text-black hover:bg-gray-200">📄 Download Template</Button>
      </a>
      <a href="https://forms.gle/MGoKjXAtmY9Cp8pF9" target="_blank">
        <Button variant="secondary" className="w-full sm:w-auto bg-black text-white hover:bg-gray-900">🚀 Submit Proposal</Button>
      </a>
    </div>
  </section>

</MainLayout>
