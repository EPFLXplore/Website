---
import Menu from "@/components/Menu";
import MainLayout from "../../../layouts/MainLayout.astro";
import { base } from "astro:config/server";

const baseUrl = import.meta.env.BASE_URL;
const imagesGlob = import.meta.glob("/public/images/xrc/*.jpg", { eager: true });
const images = Object.keys(imagesGlob).map((path) => `${baseUrl}/images/xrc/${path.split("/").pop()}`);
---

<MainLayout title="Xplore Rover Challenge | EPFL Xplore">

  <!-- Header -->
  <div class="absolute top-0 left-0 w-full">
    <Menu client:load />
  </div>

  <!-- Hero -->
  <section class="max-w-5xl mx-auto py-16 sm:py-26 text-center px-4">
    <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold mb-4 text-primary">
      Xplore Rover Challenge
    </h1>
    <p class="text-sm sm:text-base md:text-lg text-muted-foreground max-w-3xl mx-auto">
      The <strong>Education Pole</strong> of EPFL Xplore.  
      Our main goal: turning students into <strong>ERC engineers</strong> — from no prior knowledge to makers.
    </p>
    <img 
      src={`${baseUrl}/images/xrc/hero.jpg`} 
      alt="Xplore Rover Challenge Students" 
      class="rounded-xl shadow-lg w-full object-cover max-h-[250px] sm:max-h-[400px] md:max-h-[500px] mt-8 sm:mt-10"
    />
  </section>

  <!-- Mission -->
  <section class="max-w-6xl mx-auto py-16 sm:py-20 space-y-6 sm:space-y-8 px-4">
    <div class="p-4 sm:p-8 text-center">
      <h2 class="text-2xl sm:text-3xl font-bold mb-4">Our Mission</h2>
      <p class="text-sm sm:text-base md:text-lg text-gray-300">
        The Xplore Rover Challenge (XRC) is a student-centered robotics competition designed to introduce bachelor-level students to the world of robotics, teamwork, and engineering through the creation of a mini-rover.
        Organized by Xplore, XRC challenges participants to design, build, and program a rover capable of completing a variety of technical tasks in a collaborative and competitive environment.
      </p>
      <img 
        src={`${baseUrl}/images/xrc/finale.jpg`} 
        alt="Students building mini rovers" 
        class="rounded-lg shadow-lg mx-auto max-h-[250px] sm:max-h-[400px] md:max-h-[600px] object-cover mt-6 sm:mt-8"
      />
    </div>
  </section>

  <!-- Timeline -->
  <section class="max-w-6xl mx-auto py-16 sm:py-20 space-y-8 px-4">
    <h2 class="text-2xl sm:text-3xl font-bold text-center">The Road to XRC</h2>

    <div class="relative border-l border-gray-600 dark:border-gray-500 ml-3 sm:ml-4">
      {[
        { date: "Early Oct", title: "Kick-off & Workshops", text: "Intro to mechanical construction, soldering, Linux, and robotics concepts like differentials, PCB, and ROS2 with Docker" },
        { date: "Late Oct", title: "IDR (Initial Design Review)", text: "Early project planning, team role distribution, and validation of concept understanding" },
        { date: "Nov", title: "PDR (Preliminary Design Review)", text: "Mechanical design progress, component choices, and first prototypes of a test bench" },
        { date: "Early Dec", title: "CDR (Critical Design Review)", text: "Full rover architecture validation, integration planning, risk analysis ⚠️, and prototype test bench demo." },
        { date: "2nd Sem", title: "Final Sprint", text: "Debugging, testing, and refining. Getting ready for the big day" },
        { date: "May", title: "🚀 XRC Final Event", text: "Competition day: the ultimate test of your rover!" },
      ].map(({ date, title, text }) => (
        <div class="mb-8 sm:mb-10 ml-6 relative">
          <span class="absolute flex items-center justify-center w-5 h-5 sm:w-6 sm:h-6 
                      bg-primary-foreground rounded-full -left-3 ring-6 ring-background"></span>
          
          <div class="pl-4">
            <time class="mb-1 block text-xs sm:text-sm font-medium text-gray-400">{date}</time>
            <h3 class="text-base sm:text-lg font-semibold text-white">{title}</h3>
            <p class="text-xs sm:text-sm md:text-base text-gray-300">{text}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Where It Happens -->
  <section class="max-w-5xl mx-auto py-12 sm:py-16 px-4">
    <div class="bg-[#1b2540] rounded-xl p-6 sm:p-8 text-center shadow-lg">
      <h2 class="text-xl sm:text-2xl font-bold mb-3 sm:mb-4">📍 Where It Happens</h2>
      <p class="text-sm sm:text-base text-muted-foreground mb-4 sm:mb-6">
        The XRC final takes place across various iconic EPFL venues such as:
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-3 sm:gap-4 mb-4 sm:mb-6">
        <button class="px-5 sm:px-6 py-2 bg-primary-foreground text-white rounded-md shadow hover:opacity-90">
          Voutes Rolex
        </button>
        <button class="px-5 sm:px-6 py-2 bg-primary-foreground text-white rounded-md shadow hover:opacity-90">
          Agora
        </button>
      </div>
      <p class="text-sm sm:text-base text-muted-foreground">
        This event is open to students, families, and the public, aiming to spark curiosity in robotics.
      </p>
    </div>
  </section>

  <!-- Memories -->
  <section class="max-w-6xl mx-auto py-12 sm:py-16 px-4">
    <div class="bg-[#1b2540] rounded-xl p-6 sm:p-8 shadow-lg">
      <h2 class="text-xl sm:text-2xl font-bold text-center mb-4 sm:mb-6">📸 Memories from XRC</h2>
      <div class="grid grid-cols-1 xs:grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 sm:gap-4">
        {
          images &&
          images.map((src, idx) => (
            <img
              src={src}
              alt={`Gallery ${idx + 1}`}
              class="rounded-lg shadow hover:scale-105 transition-transform"
              loading="lazy"
            />
          ))
        }
      </div>
    </div>
  </section>

</MainLayout>
