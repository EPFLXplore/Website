---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import SemesterProjectsGrid from "../../components/SemesterProjectsGrid";
import Menu from "@/components/Menu";
import MainLayout from "../../layouts/MainLayout.astro";

const projects = await getCollection("semester-projects");
const typedProjects = projects as CollectionEntry<"semester-projects">[];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<MainLayout title="Semester Projects | EPFL Xplore">

  <!-- Header -->
  <div class="absolute top-0 left-0 w-full z-50">
    <Menu client:load />
  </div>

  <!-- Hero -->
  <section class="relative bg-gradient-to-b from-blue-900 via-purple-900 to-black 
    py-16 sm:py-20 md:py-28 text-center text-white px-4">
    <h1 class="text-3xl sm:text-4xl md:text-6xl font-extrabold mb-4 sm:mb-6">
      Semester Projects
    </h1>
    <p class="text-base sm:text-lg md:text-xl max-w-3xl mx-auto opacity-90 leading-relaxed">
      EPFL Xplore offers a unique opportunity for students to engage in semester projects that align with
      the vision of the association. Work on ongoing challenges like the European Rover Challenge,
      or propose your own ideas in the Xplore Research pole.
    </p>
  </section>

  <!-- Projects Grid -->
  <SemesterProjectsGrid
    client:load
    projects={typedProjects.map((project) => ({
      title: project.data.title,
      major: project.data.major,
      pole: project.data.pole,
      contact: project.data.contact,
      applyLink: `${base}${project.data.applyLink}`,
      slug: project.slug,
      taken: project.data.taken ?? false
    }))}
  />

  <!-- CTA -->
  <section class="relative bg-gradient-to-r from-purple-700 to-blue-700 py-16 
    text-center text-white rounded-xl max-w-6xl mx-auto shadow-lg mt-20 px-4">
    <h2 class="text-2xl sm:text-3xl font-extrabold mb-4">Have an idea for a project?</h2>
    <p class="text-base sm:text-lg mb-8 opacity-90">
      Submit your proposal and make it part of EPFL Xplore Research.
    </p>
    <a href={`${base}/projects/xplore-research`}
      class="inline-block px-4 sm:px-6 py-2 sm:py-3 bg-white text-black font-semibold 
      rounded-lg shadow hover:bg-gray-200 transition text-sm sm:text-base">
      Submit a Project Proposal
    </a>
  </section>

</MainLayout>
